[TEMPLATE]
# Environment Variables
#
# Local secrets and tuning live in `.env` (create it: cp .env.example .env),
# which is gitignored — never commit it. This template stays the reference
# for local overrides, `doctor --fix`, and the QA suites.
#
# Only JWT_SECRET is a real secret: set it in the local `.env`, never in a
# committed file — production refuses to boot without it (see Secrets below).
# Everything else is tuning/config and is safe to keep local.
#
# ── Secrets ──
# JWT_SECRET=                       # REQUIRED in production; leave unset in dev (random per-boot fallback)

# ── Load Testing Configuration ──
LOAD_TEST_DB_PATH=./scripts/loadTests/.runtime/database.loadtest.sqlite  # Override DB path for isolated load testing
LOAD_TEST_MODE=0 # 0: Normal, 1: Load Testing Mode — when enabled, uses LOAD_TEST_DB_PATH instead of DB_PATH

# ── Logging Configuration ──
LOG_LEVEL=          # Override auto-detected level: trace|debug|info|warn|error|fatal|silent
LOG_DIR=./logs      # Directory for rotated log files (default: ./logs)

# ── Database Resilience Configuration ──
DB_QUERY_TIMEOUT_MS=5000            # Max time (ms) for a single query before timeout error (default: 5000)
DB_TRANSACTION_TIMEOUT_MS=30000     # Max time (ms) for a transaction block before rollback (default: 30000)
DB_WAL_CHECKPOINT_INTERVAL_MS=60000 # Interval (ms) for periodic WAL checkpoints, 0 to disable (default: 60000; unset/blank = default)
DB_INTEGRITY_CHECK_ON_STARTUP=true  # Run PRAGMA integrity_check on startup (set to 'false' to skip)

# ── Disk-Full Hardening ──
DISK_MIN_FREE_BYTES=524288000       # Boot preflight: refuse to start below this many free bytes (default 500 MB; 0 disables)
DISK_WARN_FREE_GB=5                 # Runtime 'low' watermark — logged + shown in /api/health, requests still served
DISK_CRITICAL_FREE_GB=1             # Runtime 'critical' watermark — write requests short-circuit with 503 (reads stay open)
DISK_WAL_CAP_MB=256                 # Force WAL TRUNCATE checkpoint when -wal exceeds this many MB (0 disables; unset/blank = default 256)
DISK_CHECK_INTERVAL_MS=5000         # Min interval between statfs refreshes for the runtime guard (default 5000)

# ── Destructive Script Safety ──
# DB-writing scripts (reset:db, reseed:admin, seed:*) refuse to run while a
# node dev API is serving :3000 — image-validated via server/utils/liveApiGuard.js
# (which builds on server/utils/appLock.js).
# OVERRIDE — opt-in only: uncomment to proceed despite a live dev API (only
# when the listener is UNRELATED). Keep commented for normal development.
# RESET_DB_ALLOW_LIVE=1

# ── Single-Instance Lock File ──
# The server stamps a validated PID lock (logs/.app.lock, or APP_LOCK_FILE)
# at boot. While running, a watchdog re-stamps it if it vanishes or goes
# stale — preventing a "ghost lockless" server — and EXITS instead of
# overwriting a lock held by a different live process (split-brain guard).
APP_LOCK_WATCHDOG_MS=30000          # Lock + listener check interval while running (default 30000; 0 disables both: lock re-stamp and port-ownership checks)

# ── Security / Rate Limiting ──
AUTH_RATE_LIMIT_MAX=5               # Max FAILED logins per account+IP per 15-min window (successes never count; suites may want 20+)
GLOBAL_RATE_LIMIT_MAX=300           # Max total requests per 15-minute window (dev/testing: 1000)
READ_RATE_LIMIT_MAX=60              # Max read requests per minute (dev/testing: 300)
WRITE_RATE_LIMIT_MAX=300            # Max write requests per 15-minute window (dev/testing: 300; raised so write-heavy API sweep phases do not 429)

# ── PM2 Process Management ──
# These values are used by ecosystem.config.cjs for production deployments.
# Set NODE_ENV=production in the env_production block of ecosystem.config.cjs.
# PM2 file logs (out_file, error_file) are silenced — Pino handles all file rotation.
#
# Production deploy commands:
#   npm run start:prod     — Start the app via PM2
#   npm run reload          — Zero-downtime reload (fork new, SIGINT old)
#   npm run stop            — Graceful stop (SIGINT → shutdown handler)
#   npm run monit            — Real-time monitoring dashboard
#   npm run startup          — Generate system service for auto-start on boot
#   npm run save             — Persist process list for PM2 startup
#
# Tuning:
#   max_memory_restart (ecosystem.config.cjs): 400M default — adjust based on host RAM
#   kill_timeout (ecosystem.config.cjs): 10000ms default — must exceed connectionManager.close() time
