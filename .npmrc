# Install scripts are OFF project-wide (rc3 fix): a plain `npm install`
# must succeed on machines with NO C++ toolchain. Both native deps the app
# loads (better-sqlite3, bcrypt) ship bundled prebuilds that the runtime
# loader reads directly. The exception — sqlite3, the primary DB driver,
# which downloads its binary in an install script — is self-healed by the
# repo's own `postinstall` npm script (scripts/lib/sqlite3DriverCheck.js),
# which npm never skips because it is NOT a package lifecycle hook. This
# also closes the install-script supply-chain surface. If a future dep
# genuinely needs a postinstall, wire it into that script.
ignore-scripts=true
