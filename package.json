{
  "name": "it-asset-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Studio IT Asset Management Platform with React 19, Express 5, and SQLite",
  "author": "mylad01 <miladnasrollahi.mn@gmail.com> (https://github.com/mylad01)",
  "homepage": "https://github.com/mylad01/IT-asset-manager#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mylad01/IT-asset-manager.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/lib/sqlite3DriverCheck.js",
    "build": "vite build",
    "prebuild": "node scripts/lib/retiredKeysCheck.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node scripts/start.js",
    "prestart": "node scripts/lib/sqlite3DriverCheck.js",
    "test:ui": "node scripts/testUiJourney.js",
  "test:tables": "node scripts/testDataTableFirstLoad.js",
    "test:ui-settings": "node scripts/testUiSettings.js",
    "test:prefs": "node scripts/testPreferencesRegistry.js",
    "test:retired-keys": "node scripts/testRetiredKeysGate.js",
    "test:restore": "node scripts/testBackupRestoreDrill.js",
    "verify:backup": "node scripts/verifyBackup.js",
    "release:notes": "node scripts/releaseNotes.js",
    "hooks:install": "node scripts/lib/prePushGate.js --install",
    "postinstall": "node scripts/lib/sqlite3DriverCheck.js",
    "test:all": "node scripts/testAll.js",
    "kill": "node scripts/kill-server.js",
    "doctor": "node scripts/doctor.js",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop ecosystem.config.cjs",
    "reload": "pm2 reload ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "monit": "pm2 monit",
    "logs": "pm2 logs ecosystem.config.cjs",
    "status": "pm2 status",
    "startup": "pm2 startup",
    "save": "pm2 save",
    "load:read": "node scripts/loadTests/preflight.js && k6 run scripts/loadTests/scenarios/read-heavy.js",
    "load:write": "node scripts/loadTests/preflight.js && k6 run scripts/loadTests/scenarios/write-heavy.js",
    "load:auth": "node scripts/loadTests/preflight.js && k6 run scripts/loadTests/scenarios/auth-bruteforce.js",
    "bench:walab": "node scripts/loadTests/walAB.js",
    "test:server": "npx cross-env PORT=3100 LOAD_TEST_MODE=1 DB_PATH=./scripts/loadTests/.runtime/database.loadtest.sqlite APP_LOCK_FILE=./scripts/loadTests/.runtime/.loadtest.lock node server/index.js",
    "clean:delivery": "node scripts/cleanDelivery.js",
    "reset:db": "node scripts/resetDb.js",
    "seed:users": "node scripts/seedTestUsers.js",
    "seed:tickets": "node scripts/seedTickets.js",
    "seed:bulk": "node scripts/generateBulkAssets.js",
    "seed:notifications": "node scripts/seedNotifications.js",
    "reseed:admin": "node server/db/reseed-admin.js",
    "db:migrate": "node scripts/runMigrations.js",
    "db:migrate:status": "node -e \"import('./server/db/migrations/umzug-instance.js').then(async m => { const s = await m.getMigrationStatus(globalThis.__db); console.log(JSON.stringify(s, null, 2)); process.exit(0) }).catch(e => { console.error(e); process.exit(1) })\""
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "ws": "^7.5.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "nodemon": "^3.1.14",
    "oxlint": "^1.71.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^5.4.3",
    "postcss": "^8.5.26",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1"
  }
}